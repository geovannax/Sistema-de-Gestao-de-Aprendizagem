POSTGRES_CONTAINER_NAME=lms_postgres

REDIS_CONTAINER_NAME=lms_redis

NGINX_CONTAINER_NAME=lms_nginx

WEB_CONTAINER_NAME=lms_web
WEB_SECRET_KEY=''
# 'true' para desenvolvimento local | 'false' para produção
WEB_DEBUG=false
# 'true' cria usuários/turmas de teste (prof1-14, aluno1-5 etc.) via seed —
# deixe 'false' (ou omitido) em produção
CREATE_SEED=false

# Credenciais de acesso à documentação (/docs/)
DOCS_USER=docs
DOCS_PASSWORD=senha123

# Login social (Google) — criar em https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <domínio>/sistemadegestaodeaprendizagem/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Login social (GitHub) — criar em https://github.com/settings/developers (OAuth Apps)
# Authorization callback URL: <domínio>/sistemadegestaodeaprendizagem/accounts/github/login/callback/
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=


